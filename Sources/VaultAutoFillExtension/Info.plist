<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string>ExtensionIcon</string>
	<key>CFBundleIconName</key>
	<string>ExtensionIcon</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>XPC!</string>
	<key>CFBundleShortVersionString</key>
	<string>1.5.27</string>
	<key>CFBundleVersion</key>
	<string>90</string>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionAttributes</key>
		<dict>
			<key>ASCredentialProviderExtensionCapabilities</key>
			<dict>
				<key>ProvidesOneTimeCodes</key>
				<true/>
				<key>ProvidesPasskeys</key>
				<true/>
				<key>ProvidesPasswords</key>
				<true/>
				<key>SupportedCredentialExchangeVersions</key>
				<array>
					<string>1.0</string>
				</array>
				<key>SupportsCredentialExchange</key>
				<true/>
			</dict>
		</dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.authentication-services-credential-provider-ui</string>
		<key>NSExtensionPrincipalClass</key>
		<string>VaultCredentialProviderViewController</string>
	</dict>
	<key>NSFaceIDUsageDescription</key>
	<string>Vault UI uses Touch ID to securely autofill your passwords.</string>
	<key>VaultUIAppGroupIdentifier</key>
	<string>$(VAULTUI_APP_GROUP)</string>
	<key>VaultUIAutoFillExtensionBundleIdentifier</key>
	<string>$(VAULTUI_AUTOFILL_BUNDLE_ID)</string>
	<key>VaultUIBundleIdentifier</key>
	<string>$(VAULTUI_BUNDLE_ID)</string>
	<key>VaultUIKeychainAccessGroup</key>
	<string>$(AppIdentifierPrefix)$(VAULTUI_KEYCHAIN_GROUP)</string>
	<key>VaultUISafariExtensionBundleIdentifier</key>
	<string>$(VAULTUI_SAFARI_BUNDLE_ID)</string>
	<key>VaultUITeamPrefixedAppGroupIdentifier</key>
	<string>$(TeamIdentifierPrefix)$(VAULTUI_APP_GROUP)</string>
</dict>
</plist>
