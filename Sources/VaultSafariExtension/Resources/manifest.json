{
  "manifest_version": 3,
  "name": "Vault UI Autofill",
  "version": "1.0",
  "description": "Autofill passwords for Vault UI",
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "nativeMessaging",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
