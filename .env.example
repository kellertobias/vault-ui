# Copy this file to .env and fill in values for your Apple Developer account.

# Required for signed app archives. This is your 10-character Apple Developer
# Team ID from Xcode Settings > Accounts.
VAULTUI_DEVELOPMENT_TEAM=YOUR_TEAM_ID

# Bundle identifiers must be registered to your Apple Developer account.
VAULTUI_BUNDLE_ID=com.yourname.vaultui
VAULTUI_AUTOFILL_BUNDLE_ID=com.yourname.vaultui.AutoFillExtension
VAULTUI_SAFARI_BUNDLE_ID=com.yourname.vaultui.SafariExtension

# These must match the App Group and Keychain Sharing capabilities registered
# for the bundle identifiers above.
VAULTUI_APP_GROUP=group.com.yourname.vaultui
VAULTUI_KEYCHAIN_GROUP=com.yourname.vaultui.shared

# Optional build locations. Defaults are shown here for reference.
# DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
# DERIVED_DATA_PATH=.build/xcode
# ARCHIVE_PATH=.build/archive/VaultUI.xcarchive
# INSTALL_DIR=/Applications

# Optional distribution locations. Defaults are shown here for reference.
# DISTRIBUTION_DIR=.build/distribute
# EXPORT_PATH=.build/distribute/export
# DISTRIBUTION_ZIP=.build/distribute/VaultUI.zip

# Required for ./build distribute.
# Use a Developer ID Application certificate, not an Apple Development certificate.
# The default identity name usually works when the certificate is installed.
# VAULTUI_DISTRIBUTION_CERTIFICATE=Developer ID Application

# Notarization option A: use a notarytool keychain profile.
# Create it once with:
# xcrun notarytool store-credentials vaultui-notary --apple-id YOUR_APPLE_ID --team-id YOUR_TEAM_ID --password YOUR_APP_SPECIFIC_PASSWORD
# VAULTUI_NOTARY_KEYCHAIN_PROFILE=vaultui-notary

# Notarization option B: use Apple ID credentials directly from .env.
# Prefer an app-specific password from appleid.apple.com.
# VAULTUI_NOTARY_APPLE_ID=you@example.com
# VAULTUI_NOTARY_TEAM_ID=YOUR_TEAM_ID
# VAULTUI_NOTARY_PASSWORD=xxxx-xxxx-xxxx-xxxx
